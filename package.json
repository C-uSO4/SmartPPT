{
  "name": "smartppt",
  "version": "0.1.0",
  "private": true,
  "description": "Online, dependency-free PPT outline parsing, native PPTX generation and fidelity auditing in the browser",
  "scripts": {
    "start": "node src/web/server.js",
    "build": "node scripts/build-online.cjs",
